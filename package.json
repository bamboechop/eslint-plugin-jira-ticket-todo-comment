{
  "author": "bamboechop <npmjs@bamboechop.at>",
  "description": "Checks TODO comments and informs about missing Jira (or other issue tracking system) ticket mentions",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-eslint-plugin": "^7.3.2",
    "eslint-plugin-n": "^17.24.0",
    "globals": "^17.5.0",
    "mocha": "^11.7.5"
  },
  "engines": {
    "node": "12.x || 14.x || >= 16"
  },
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "jira",
    "jiraticket",
    "jira-ticket",
    "jiraticketcomment",
    "jira-ticket-comment",
    "jiratickettodocomment",
    "jira-ticket-todo-comment",
    "todo",
    "todocomment",
    "todo-comment",
    "linear",
    "linearticket",
    "linear-ticket",
    "linearticketcomment",
    "linear-ticket-comment",
    "lineartickettodocomment",
    "linear-ticket-todo-comment"
  ],
  "license": "ISC",
  "main": "lib/index.js",
  "name": "eslint-plugin-jira-ticket-todo-comment",
  "peerDependencies": {
    "eslint": ">=6"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/bamboechop/eslint-plugin-jira-ticket-todo-comment"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "mocha tests --recursive",
    "test:compat": "npm run test:compat:eslint6 && npm run test:compat:eslint10",
    "test:compat:eslint6": "npm exec --yes --package eslint@6.8.0 -- node scripts/eslint-compat-smoke.js 6.8.0",
    "test:compat:eslint10": "npm exec --yes --package eslint@10.2.1 -- node scripts/eslint-compat-smoke.js 10.2.1"
  },
  "overrides": {
    "diff": "^8.0.3",
    "serialize-javascript": "^7.0.5"
  },
  "version": "1.0.6"
}
